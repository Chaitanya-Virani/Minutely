# =============================================================================
# Minutely — root environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` (and to backend/.env, frontend/.env.local) and fill
# in real values before running locally or with docker-compose. Never commit
# populated .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI) — see backend/.env.example
# -----------------------------------------------------------------------------

# Secret API key for the Anthropic Claude API. Required.
ANTHROPIC_API_KEY=

# Anthropic model id used for report generation. Do not change unless you know
# the new id is GA and supports the 1M context window + tool_use.
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum accepted upload size per file, in megabytes.
MAX_FILE_SIZE_MB=25

# Comma-separated list of origins allowed by FastAPI CORS middleware.
CORS_ORIGINS=http://localhost:3000

# Port the backend HTTP server binds to. Railway injects PORT at runtime and
# will override this value in production.
PORT=8000

# -----------------------------------------------------------------------------
# Frontend (Next.js) — forthcoming; see frontend/.env.local.example
# -----------------------------------------------------------------------------

# Public base URL of the backend API, embedded into the client bundle.
# Local dev: http://localhost:8000
# Production: the backend's public Railway URL (https://...).
NEXT_PUBLIC_API_URL=http://localhost:8000
